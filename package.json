{
  "name": "exsurge",
  "version": "0.1.0",
  "description": "A JavaScript library for rendering Gregorian Chant in square note notation",
  "type": "module",
  "main": "./dist/exsurge.cjs",
  "module": "./dist/exsurge.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/exsurge.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/exsurge.mjs",
      "require": "./dist/exsurge.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite --config vite.demo.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.1",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/driacats/exsurge.git"
  },
  "author": "Fr. Matthew Spencer, O.S.J. <mspencer@osjusa.org> (http://marello.org)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/driacats/exsurge/issues"
  },
  "homepage": "https://github.com/driacats/exsurge#readme",
  "keywords": [
    "gregorian",
    "chant",
    "square",
    "note",
    "solesmes",
    "gabc"
  ]
}
